{
  "name": "gadget50/laravel-newsroom",
  "type": "project",
  "require": {"php": ">=8.2", "laravel/framework": "^11.0", "laravel/tinker": "^2.9"},
  "require-dev": {"fakerphp/faker": "^1.23", "laravel/pint": "^1.13", "phpunit/phpunit": "^10.5"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"], "setup": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --seed", "@php artisan storage:link"]},
  "minimum-stability": "stable",
  "prefer-stable": true
}
